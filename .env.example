# Copy this file to `.env` and adjust the values for your machine:
#
#   cp .env.example .env
#
# `.env` is git-ignored; `.env.example` is committed and must stay free of
# secrets, so it only ever documents the variables everyone needs.

# Base URL of the backend API.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle, and for the
# production image they are baked in at build time (see DOCKER.md). For local
# development the backend usually runs on your own machine, on port 8000:
NEXT_PUBLIC_API_URL=http://localhost:8000
